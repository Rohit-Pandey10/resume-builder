# Server HTTP port for local development (default: 5001)
PORT=5001

# Application environment ('development', 'test', 'production')
NODE_ENV=development

# MongoDB connection string (e.g. mongodb+srv://... on Atlas or mongodb://localhost:27017/jakeresume)
# If empty in local dev, an ephemeral in-memory MongoDB instance will be used
MONGODB_URI=

# Secret key used for signing and verifying JWT authentication tokens
# In production, must be at least 32 characters long
JWT_SECRET=

# Public Google OAuth 2.0 Client ID for backend token verification against Google APIs
GOOGLE_CLIENT_ID=

# Allowed frontend URL for CORS policy in production (e.g. https://your-app.vercel.app)
CLIENT_URL=
